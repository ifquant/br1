{
  "name": "br1",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm setup-vendors && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:reader-helpers": "pnpm exec svelte-kit sync && pnpm exec tsc -p tsconfig.json --outDir .tmp-reader-helper-tests --noEmit false && node --test ./.tmp-reader-helper-tests/src/lib/reader/inlineTranslation.test.js ./.tmp-reader-helper-tests/src/lib/reader/readingMode.test.js ./.tmp-reader-helper-tests/src/lib/reader/playbackQueue.test.js ./.tmp-reader-helper-tests/src/lib/reader/maturityMode.test.js ./.tmp-reader-helper-tests/src/lib/reader/currentBookPersistence.test.js ./.tmp-reader-helper-tests/src/lib/reader/ttsOwnership.test.js ./.tmp-reader-helper-tests/src/lib/reader/shortcuts.test.js ./.tmp-reader-helper-tests/src/lib/reader/pdfText.test.js ./.tmp-reader-helper-tests/src/lib/reader/notesController.test.js && rm -rf .tmp-reader-helper-tests",
    "test:pdf-vendor": "pnpm build && node --test tests/pdfjs-vendor.test.mjs tests/pdfjs-packaged-runtime.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:tauri": "bash scripts/automation/test-tauri-webdriver.sh pnpm exec wdio run wdio.conf.ts",
    "test:e2e:tauri:packaged-pdf": "bash scripts/automation/test-tauri-webdriver-packaged-pdf.sh",
    "test:e2e:tauri:startup-associated-open": "bash scripts/automation/test-tauri-webdriver-startup-associated-open.sh",
    "test:e2e:tauri:startup-associated-open:stress": "bash scripts/automation/test-tauri-webdriver-startup-associated-open-stress.sh",
    "test:tauri:webdriver": "bash scripts/automation/test-tauri-webdriver.sh",
    "tauri": "tauri",
    "prepare-public-vendor": "node scripts/setup-pdfjs-vendor.mjs prepare",
    "copy-pdfjs-js": "node scripts/setup-pdfjs-vendor.mjs copy-js",
    "copy-pdfjs-wasm": "node scripts/setup-pdfjs-vendor.mjs copy-wasm",
    "copy-pdfjs-fonts": "node scripts/setup-pdfjs-vendor.mjs copy-fonts",
    "copy-flatten-pdfjs-annotation-layer-css": "node scripts/setup-pdfjs-vendor.mjs copy-annotation-css",
    "copy-flatten-pdfjs-text-layer-css": "node scripts/setup-pdfjs-vendor.mjs copy-text-css",
    "copy-flatten-pdfjs-css": "node scripts/setup-pdfjs-vendor.mjs copy-css",
    "copy-pdfjs": "pnpm copy-pdfjs-js && pnpm copy-pdfjs-wasm && pnpm copy-pdfjs-fonts && pnpm copy-flatten-pdfjs-css",
    "setup-pdfjs": "pnpm prepare-public-vendor && pnpm copy-pdfjs",
    "setup-vendors": "pnpm setup-pdfjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "construct-style-sheets-polyfill": "^3.1.0",
    "dompurify": "^3.4.0",
    "foliate-js": "file:../foliate-js",
    "overlayscrollbars": "^2.14.0",
    "overlayscrollbars-svelte": "^0.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/types": "^9.27.0",
    "pdfjs-dist": "^5.6.205",
    "postcss": "^8.5.8",
    "postcss-nested": "^7.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
